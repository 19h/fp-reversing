(set-logic QF_BV)
(set-option :timeout 30000)
(declare-fun value () (_ BitVec 64))
(define-fun stored () (_ BitVec 64) (bvxor value #xda8ca8cae5dfbd2d))
(define-fun b0 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 63 56) stored)))
(define-fun b1 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 55 48) stored)))
(define-fun b2 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 47 40) stored)))
(define-fun b3 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 39 32) stored)))
(define-fun b4 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 31 24) stored)))
(define-fun b5 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 23 16) stored)))
(define-fun b6 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 15 8) stored)))
(define-fun b7 () (_ BitVec 32) ((_ zero_extend 24) ((_ extract 7 0) stored)))
(define-fun out0 () (_ BitVec 8) ((_ extract 7 0) (bvadd (bvsub (bvxor b0 #x000018da) (bvand (bvshl (bvxor b0 #x000018da) #x00000001) #xffffffe7)) #x00000073)))
(define-fun out1 () (_ BitVec 8) ((_ extract 7 0) (bvadd (bvsub (bvxor b1 #x0000008c) (bvand (bvshl b1 #x00000001) #xffffffe7)) #x00000073)))
(define-fun out2 () (_ BitVec 8) ((_ extract 7 0) (bvadd (bvsub (bvxor b2 #xffffffa8) (bvshl (bvxor (bvand (bvxor b2 #xffffffa8) #xfffffff7) (bvand b2 #x00000004)) #x00000001)) #x00000073)))
(define-fun out3 () (_ BitVec 8) ((_ extract 7 0) (bvadd (bvsub (bvxor b3 #xffffffca) (bvand (bvshl (bvxor b3 #xffffffca) #x00000001) #xffffffe7)) #x00000073)))
(define-fun out4 () (_ BitVec 8) ((_ extract 7 0) (bvadd (bvsub (bvxor b4 #xffffffe5) (bvand (bvshl (bvxor b4 #xffffffe5) #x00000001) #xffffffe7)) #x00000073)))
(define-fun out5 () (_ BitVec 8) ((_ extract 7 0) (bvadd (bvsub (bvxor b5 #xffffffdf) (bvand (bvshl (bvxor b5 #xffffffdf) #x00000001) #xffffffe7)) #x00000073)))
(define-fun out6 () (_ BitVec 8) ((_ extract 7 0) (bvadd (bvsub (bvxor b6 #xffffffbd) (bvand (bvshl (bvxor b6 #xffffffbd) #x00000001) #xffffffe7)) #x00000073)))
(define-fun out7 () (_ BitVec 8) ((_ extract 7 0) (bvxor b7 #x0000005e)))
(assert (or (distinct out0 (bvxor ((_ extract 63 56) value) #x73)) (distinct out1 (bvxor ((_ extract 55 48) value) #x73)) (distinct out2 (bvxor ((_ extract 47 40) value) #x73)) (distinct out3 (bvxor ((_ extract 39 32) value) #x73)) (distinct out4 (bvxor ((_ extract 31 24) value) #x73)) (distinct out5 (bvxor ((_ extract 23 16) value) #x73)) (distinct out6 (bvxor ((_ extract 15 8) value) #x73)) (distinct out7 (bvxor ((_ extract 7 0) value) #x73))))
(check-sat)
